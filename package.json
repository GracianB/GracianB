{
  "name": "gracianb-hub",
  "version": "2.1.0",
  "description": "Gracián Baena — People × Data × Systems. Personal hub: three worlds, CVs and letters ES/EN",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "audit": "lighthouse https://gracianb.github.io/GracianB/ --view",
    "a11y:check": "pa11y https://gracianb.github.io/GracianB/"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "vite": "^5.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "lighthouse": "^11.4.0",
    "pa11y-ci": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
